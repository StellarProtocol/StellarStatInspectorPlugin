<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS8632;CS8765</NoWarn>
    <RootNamespace>Stellar.StatInspector</RootNamespace>
    <AssemblyName>Stellar.StatInspector</AssemblyName>
    <Version>1.1.0</Version>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Stellar.Abstractions" Version="1.1.1" />
    <PackageReference Include="Stellar.Plugin.InteropRefs" Version="1.1.1" />
  </ItemGroup>

  <!-- Bundled stat-icon atlas + settings-gear (StatIconAtlas reads these by LogicalName). Without them the
       published DLL ships iconless and every stat row renders a blank white square / the mini-HUD gear is missing. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources/stat-icon-atlas.png" LogicalName="Stellar.StatInspector.stat-icon-atlas.png" />
    <EmbeddedResource Include="Resources/settings-gear.png" LogicalName="Stellar.StatInspector.settings-gear.png" />
  </ItemGroup>
</Project>
